#!/usr/bin/env sh

exec 9>/tmp/niri-monitors.lock
flock -n 9 || exit 0

last_topology=""
candidate_topology=""
candidate_count=0
last_power=""
power_candidate=""
power_candidate_count=0

stable_samples=3

mon_n="BOE 0x0BCA Unknown"
mon_l="Philips Consumer Electronics Company 27E1N1200A UHB2549032242"
mon_r="Philips Consumer Electronics Company 27E1N1200A UHB2549032244"

move_workspaces() {
    monitor=$1
    direction=$2

    for nw in $(seq 1 9); do
        niri msg action \
            move-workspace-to-monitor \
            --reference "${direction}${nw}" \
            "$monitor"
    done

    niri msg action focus-monitor "$monitor"

    for nw in $(seq 1 9); do
        niri msg action \
            move-workspace-to-index \
            --reference "${direction}${nw}" \
            "${nw}"
    done
}

apply_topology() {
    topology=$1

    case $topology in
        laptop)
            niri msg output "$mon_n" on || return 1
            move_workspaces "$mon_n" "l"
            move_workspaces "$mon_n" "r"
            ;;
        left)
            niri msg output "$mon_n" on || return 1
            niri msg output "$mon_l" on || return 1
            move_workspaces "$mon_l" "l"
            move_workspaces "$mon_n" "r"
            ;;
        right)
            niri msg output "$mon_n" on || return 1
            niri msg output "$mon_r" on || return 1
            move_workspaces "$mon_n" "l"
            move_workspaces "$mon_r" "r"
            ;;
        both)
            niri msg output "$mon_l" on || return 1
            niri msg output "$mon_r" on || return 1
            move_workspaces "$mon_l" "l"
            move_workspaces "$mon_r" "r"
            niri msg output "$mon_n" off || return 1
            ;;
        *)
            return 1
            ;;
    esac

    return 0
}

set_power_profile() {
    ac_online=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null || echo 0)
    want="balanced"
    [ "$ac_online" = "1" ] && want="performance"

    if [ "$want" = "$last_power" ]; then
        power_candidate=""
        power_candidate_count=0
        return
    fi

    if [ "$want" = "$power_candidate" ]; then
        power_candidate_count=$((power_candidate_count + 1))
    else
        power_candidate=$want
        power_candidate_count=1
    fi

    if [ "$power_candidate_count" -ge "$stable_samples" ]; then
        if sudo powerprofilesctl set "$want"; then
            last_power=$want
            power_candidate=""
            power_candidate_count=0
        fi
    fi
}

observe_topology() {
    out=$1

    left=0
    right=0
    printf '%s\n' "$out" | grep -Fq "$mon_l" && left=1
    printf '%s\n' "$out" | grep -Fq "$mon_r" && right=1

    if [ "$left" -eq 1 ] && [ "$right" -eq 1 ]; then
        printf '%s\n' both
    elif [ "$left" -eq 1 ]; then
        printf '%s\n' left
    elif [ "$right" -eq 1 ]; then
        printf '%s\n' right
    else
        printf '%s\n' laptop
    fi
}

record_candidate() {
    observed=$1

    if [ "$observed" = "$candidate_topology" ]; then
        candidate_count=$((candidate_count + 1))
    else
        candidate_topology=$observed
        candidate_count=1
        printf 'niri-monitors: observed %s topology; waiting for stability\n' "$observed"
    fi
}

while :; do
    out=$(niri msg outputs 2>/dev/null) || {
        sleep 5
        continue
    }

    observed=$(observe_topology "$out")

    if [ "$observed" = "$last_topology" ]; then
        candidate_topology=""
        candidate_count=0
    else
        record_candidate "$observed"
        if [ "$candidate_count" -ge "$stable_samples" ]; then
            verify=$(niri msg outputs 2>/dev/null) || verify=""
            if [ "$(observe_topology "$verify")" = "$observed" ]; then
                printf 'niri-monitors: applying %s topology\n' "$observed"
                if apply_topology "$observed"; then
                    last_topology=$observed
                    printf 'niri-monitors: %s topology active\n' "$observed"
                else
                    printf 'niri-monitors: failed to apply %s topology\n' "$observed" >&2
                fi
            fi
            candidate_topology=""
            candidate_count=0
        fi
    fi

    set_power_profile

    sleep 5
done
