#!/usr/bin/env bash

shopt -s nullglob globstar

prefix=${PASSWORD_STORE_DIR:-"$HOME/.local/share/password-store"}
password_files=( "$prefix"/**/*.gpg )
password_files=( "${password_files[@]#"$prefix"/}" )
password_files=( "${password_files[@]%.gpg}" )

if [[ -n ${WAYLAND_DISPLAY:-} ]] || [[ ${XDG_SESSION_TYPE:-} == "wayland" ]]; then
    dmenu_cmd=(dmenu-niri)
elif [[ "$OSTYPE" == "darwin"* ]]; then
    dmenu_cmd=(dmenu-mac)
else
    dmenu_cmd=(dmenu)
fi

password=$(printf '%s\n' "${password_files[@]}" | "${dmenu_cmd[@]}" "$@")

[[ -n $password ]] || exit

pass_cmd=show
if pass show "$password" | grep -q '^otpauth://'; then
    pass_cmd=otp
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
	pass $pass_cmd "$password" | pbcopy
else
	pass $pass_cmd -c "$password" 2>/dev/null
fi

